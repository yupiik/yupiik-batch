{
  "name": "yupiik-batch-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rsbuild/core": "2.3.2",
    "@rsbuild/plugin-react": "2.1.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "json-rpc-2.0": "1.8.1"
  },
  "scripts": {
    "start": "rsbuild dev",
    "build": "rsbuild build",
    "lint": "eslint src dev test rsbuild.config.mjs eslint.config.mjs",
    "test": "node --test test/*.test.mjs src/service/*.test.mjs",
    "check": "npm run lint && npm test",
    "audit:dependencies": "npm audit --include=dev"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
